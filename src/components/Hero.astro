---
import Icon from "./Icon.astro";
import { mainPhone, telegram, address, hours } from "../data/site";
---
<section id="hero" class="hero" data-rec="R-002,R-004,R-009,GA-R002,S-R006" aria-labelledby="hero-title">
  <div class="hero__top container">
    <div class="hero__copy">
      <h1 id="hero-title">Відновлення вузлів авто у Львові</h1>
      <p class="hero__lead">Турбіни, паливна апаратура, рульові рейки, двигуни і фільтри сажі. Вузол перевіряємо на стенді двічі: до ремонту і після.</p>
    </div>
    <div class="hero__obj">
      <img
        src="img/turbine-480.webp"
        srcset="img/turbine-480.webp 480w, img/turbine-617.webp 617w"
        sizes="(min-width: 64rem) 460px, 180px"
        width="617" height="588"
        alt="Турбіна Garrett на стенді"
        fetchpriority="high"
        data-reveal
      />
    </div>
  </div>

  <div class="plate">
    <div class="plate__in container">
      <div class="plate__acts" data-rec="R-001">
        <a class="btn btn--call plate__call" href={`tel:${mainPhone.tel}`}>
          <Icon name="phone" />
          <span class="btn__stack"><span>Подзвонити в сервіс</span><small class="num">{mainPhone.label}</small></span>
        </a>
        <a class="btn btn--line plate__tg" href={telegram} rel="noopener" target="_blank">
          <Icon name="telegram" /><span>Написати в Telegram</span>
        </a>
      </div>
      <p class="plate__where"><strong>{address}</strong><br />{hours}</p>
    </div>
  </div>

  <div class="hero__next container">
    <a class="hero__next-link" href="#services"><span>Оберіть свій вузол</span><Icon name="down" /></a>
  </div>
</section>

<style>
  .hero { background: var(--color-bg); }
  .hero__top { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-2); padding-top: var(--s-4); }
  .hero__copy { display: grid; gap: var(--s-2); align-content: center; }
  h1 { font-size: var(--fs-h1); font-stretch: 120%; font-weight: 700; line-height: 1.02; letter-spacing: -0.01em; max-width: 15ch; text-wrap: balance; }
  .hero__lead { font-size: var(--fs-body); line-height: 1.45; color: var(--color-muted); max-width: 34rem; }
  .hero__obj { display: flex; justify-content: flex-end; align-items: flex-end; height: 150px; margin-bottom: -8px; }
  .hero__obj img { height: 100%; width: auto; max-width: 100%; object-fit: contain; object-position: bottom; }

  .plate { background: var(--color-brand); color: var(--color-text); }
  .plate__in { display: grid; gap: var(--s-2); padding-block: var(--s-3); }
  .plate__acts { display: grid; gap: var(--s-1); }
  .plate__call { justify-content: flex-start; padding-block: 8px; white-space: nowrap; line-height: 1.1; font-size: 1rem; }
  .plate__call .btn__stack { gap: 0; }
  .plate__call .btn__stack small { font-family: var(--font-display); font-stretch: 110%; font-weight: 700; font-size: 1rem; line-height: 1.1; }
  .plate__tg { min-height: 48px; }
  .plate__where { font-size: var(--fs-small); line-height: 1.45; }
  .plate__where strong { font-size: var(--fs-body); }

  .hero__next { padding-block: var(--s-2) var(--s-1); }
  .hero__next-link {
    display: inline-flex; align-items: center; gap: var(--s-1); min-height: var(--tap);
    color: var(--color-text); text-decoration: none; font-weight: 700; border-radius: var(--radius);
  }
  .hero__next-link span { text-decoration: underline; text-decoration-color: var(--color-brand); text-decoration-thickness: 2px; text-underline-offset: .3em; }
  .hero__next-link :global(.icon) { transition: transform 200ms var(--ease-out); }
  .hero__next-link:hover :global(.icon) { transform: translateY(3px); }

  /* Effect 1 (§8.8): the part is set down on the stand (data-reveal + rules in site.css). Text and buttons stay static. */

  @media (min-width: 40rem) {
    .plate__acts { grid-template-columns: auto auto; justify-content: start; }
    .hero__obj { height: 220px; }
  }
  @media (min-width: 64rem) {
    .hero__top { grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 24px; padding-top: var(--s-6); }
    .hero__copy { grid-column: 1 / span 7; padding-bottom: var(--s-6); }
    .hero__lead { font-size: var(--fs-lead); line-height: 1.4; }
    .hero__obj { grid-column: 8 / span 5; height: clamp(320px, 54svh, 540px); justify-content: center; }
    .plate__in { grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 24px; align-items: center; padding-block: var(--s-4); }
    .plate__acts { grid-column: 1 / span 8; }
    .plate__where { grid-column: 9 / span 4; }
  }
</style>
