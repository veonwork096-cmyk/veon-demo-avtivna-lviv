---
// Small line icons, colour = currentColor, always decorative (the control carries the text).
type Name = "phone" | "telegram" | "route" | "down" | "instagram" | "facebook" | "mail" | "menu" | "close";
interface Props { name: Name; class?: string; }
const { name, class: cls } = Astro.props;
---
<svg class:list={["icon", cls]} viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
  {name === "phone" && <path d="M5 3h3.5l1.6 4.4-2.3 1.5a11 11 0 0 0 7.3 7.3l1.5-2.3L21 15.5V19a2 2 0 0 1-2.2 2A17 17 0 0 1 3 5.2 2 2 0 0 1 5 3z" />}
  {name === "telegram" && <path d="M21 4 3 11.2l6.2 2.2L18 7.5l-6.8 7.1 6.3 5.4L21 4zM9.2 13.4V19l2.9-3" />}
  {name === "route" && <><path d="M12 21s-6.5-6.1-6.5-11a6.5 6.5 0 0 1 13 0c0 4.9-6.5 11-6.5 11z" /><circle cx="12" cy="10" r="2.3" /></>}
  {name === "down" && <path d="M12 4v15m-6-6 6 6 6-6" />}
  {name === "instagram" && <><rect x="3.5" y="3.5" width="17" height="17" rx="4.5" /><circle cx="12" cy="12" r="4" /><path d="M17.2 6.8h.01" /></>}
  {name === "facebook" && <path d="M14.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.6-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H9v3h2.5V21" />}
  {name === "mail" && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3.5 6 8.5 7 8.5-7" /></>}
  {name === "menu" && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === "close" && <path d="M6 6l12 12M18 6 6 18" />}
</svg>
<style>
  .icon { display: block; width: 1.25em; height: 1.25em; flex: none; }
</style>
