---
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/site.css";

interface Props { lang: string; title: string; description: string; canonical?: string; }
const { lang, title, description, canonical } = Astro.props;

// Self-hosted fonts (OFL, from @fontsource): only cyrillic + latin subsets, font-display: swap.
// Relative URLs keep the build working from any base path (GitHub Pages sub-folder) and from file://.
const fontFaces = `
@font-face{font-family:"Science Gothic";font-style:normal;font-display:swap;font-weight:100 900;font-stretch:50% 200%;src:url(fonts/science-gothic-cyrillic-wdth-normal.woff2) format("woff2-variations"),url(fonts/science-gothic-cyrillic-wdth-normal.woff2) format("woff2");unicode-range:U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116}
@font-face{font-family:"Science Gothic";font-style:normal;font-display:swap;font-weight:100 900;font-stretch:50% 200%;src:url(fonts/science-gothic-latin-wdth-normal.woff2) format("woff2-variations"),url(fonts/science-gothic-latin-wdth-normal.woff2) format("woff2");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:"Arsenal";font-style:normal;font-display:swap;font-weight:400;src:url(fonts/arsenal-cyrillic-400-normal.woff2) format("woff2");unicode-range:U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116}
@font-face{font-family:"Arsenal";font-style:normal;font-display:swap;font-weight:400;src:url(fonts/arsenal-latin-400-normal.woff2) format("woff2");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:"Arsenal";font-style:normal;font-display:swap;font-weight:700;src:url(fonts/arsenal-cyrillic-700-normal.woff2) format("woff2");unicode-range:U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116}
@font-face{font-family:"Arsenal";font-style:normal;font-display:swap;font-weight:700;src:url(fonts/arsenal-latin-700-normal.woff2) format("woff2");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js")</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="preload" href="fonts/science-gothic-cyrillic-wdth-normal.woff2" as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFaces}></style>
    <slot name="head" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">{lang.startsWith("uk") ? "До змісту" : lang.startsWith("ru") ? "К содержанию" : "Skip to content"}</a>
    <slot name="header" />
    <main id="main"><slot /></main>
    <slot name="footer" />
    <script src="../scripts/reveal.ts"></script>
  </body>
</html>
<style is:global>
  html, body { overflow-x: clip; }
</style>
